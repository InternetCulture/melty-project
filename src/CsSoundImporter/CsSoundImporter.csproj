<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CsSoundImporter</AssemblyName>
    <RootNamespace>LosSantosStrike.Importer</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Shared/*.cs" Link="Shared/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ValveResourceFormat" Version="20.0.6980" />
    <PackageReference Include="NLayer" Version="1.16.0" />
  </ItemGroup>
</Project>
